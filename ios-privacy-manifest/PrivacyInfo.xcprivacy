<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Required reason API: UserDefaults — used to store local decision log
       and user preferences. Category CA92.1: "Accessing info from same app." -->
  <key>NSPrivacyAccessedAPITypes</key>
  <array>
    <dict>
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array>
        <string>CA92.1</string>
      </array>
    </dict>
  </array>

  <!-- No data is collected or tracked by default.
       Cloud sync (off by default) would collect anonymized numeric decision
       data (no text) only after explicit user opt-in. -->
  <key>NSPrivacyCollectedDataTypes</key>
  <array></array>

  <key>NSPrivacyTracking</key>
  <false/>

  <key>NSPrivacyTrackingDomains</key>
  <array></array>
</dict>
</plist>
